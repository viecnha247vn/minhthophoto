        <div class="ph">{% bia hinh.chan_dung_gioi_thieu, "Chân dung NSNA Phan Minh Thọ trong bộ vest đen, cầm chiếc máy ảnh phim Minolta", "(max-width: 860px) 100vw, 400px" %}</div>
